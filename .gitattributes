# Normalize text across platforms; keep binaries intact.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.pdf      binary
*.sdocx    binary
*.sqlite   binary
*.sqlite3  binary
*.db       binary
*.qcow2    binary
*.fd       binary
*.iso      binary
*.exe      binary
*.zip      binary
*.whl      binary
*.safetensors binary
*.pt       binary
*.bin      binary
*.onnx     binary
*.page     binary

