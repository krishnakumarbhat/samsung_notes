# AGENT INSTRUCTION: key is read from env GOOGLE_API_KEY automatically if present; otherwise set it here.
GEMINI_API_KEY=your_key_here
# model fallback chain: this first, then gemini-2.5-flash-lite, then gemini-2.0-flash (auto on 429/503)
GEMINI_MODEL=gemini-3.7-flash
# embedding model (Gemini native)
GEMINI_EMBED_MODEL=gemini-embedding-001
# optional override: folder of notes to auto-ingest on startup (pdf/md/txt)
# NOTES_DIR=/path/to/vault/attachments
# --- question factory (host-side micro-batches) ---
# Primary model thinks before answering; the lite model takes over on 400/404.
QUIZ_PRIMARY_MODEL=gemini-3.8-flash
QUIZ_FALLBACK_MODEL=gemini-3.5-flash-lite
# 0 disables thinking (fastest); 1024 is the default trade-off.
QUIZ_THINKING_BUDGET=1024
