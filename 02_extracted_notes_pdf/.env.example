# Local-only guest credential. Copy to .env and chmod 600 before use.
SAMSUNG_NOTES_PASSWORD=your_guest_password

# Optional local paths; defaults are under ai_agend_history/.
# SN_EXPORT_WORK=/path/to/private/work
# SN_PAGE_CACHE_DIR=/path/to/private/page_cache
# Set to 1 only when invoking the dedicated OCR pipeline environment.
# SN_PIPELINE_OCR_ENV=1
# Override the bundled renderer only when you have verified its checksum.
# SAM_SDOCX_CLI=/absolute/path/to/sdocx-cli
