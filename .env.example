# Samsung Notes workspace configuration
# Copy to .env and fill in real values. .env is git-ignored.

# Google / Gemini API key (also honored as GOOGLE_API_KEY by legacy readers).
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model chain for the Socratic tutor / RAG grader.
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Retry policy (applied with jitter on 429/5xx/timeout).
GEMINI_MAX_RETRIES=5
GEMINI_INITIAL_BACKOFF_SEC=2.0
GEMINI_BACKOFF_MULTIPLIER=2.0

# Prompt budget guard (estimated tokens) for tutor calls.
GEMINI_PROMPT_TOKEN_BUDGET=1800

# Daily review cap (subject to inactivity decay in recall app).
DAILY_REVIEW_CAP=15

# Local CPU semantic embeddings; no note uploads or HTTP embedding calls.
LOCAL_EMBED_MODEL=05_environments_and_venvs/models/bge-small-en-v1.5
LOCAL_INDEX_EMBED_MODE=semantic
